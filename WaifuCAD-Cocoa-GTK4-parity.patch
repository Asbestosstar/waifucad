+                 constraintName.ptr, sketch.name.ptr(), name.ptr, newPoint, existing.name.ptr(), snapPoints[newPoint]);
+        result = submitGenerated(context, command.ptr);
+        if (result != 0) return result;
+    }
+    return 0;
+}
