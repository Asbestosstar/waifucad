# Parametric main battle tank — dotless unit spelling (220mm, 90deg).
# Run: ./bin/waifucad-batch --script tank.wcs
waifucad(0.2)
model(:tank)

param(:hull_length, 220mm)
param(:hull_width, 110mm)
param(:hull_height, 24mm)
param(:track_width, 26mm)
param(:track_height, 26mm)
param(:wheel_radius, 15mm)
param(:wheel_width, 24mm)
param(:wheel_z, 15mm)
param(:turret_radius, 34mm)
param(:turret_height, 18mm)
param(:dome_radius, 20mm)
param(:barrel_radius, 4mm)
param(:barrel_length, 140mm)

# Derived placement — compound expressions stay in param_expr (proven path).
param_expr(:track_y, :mm, "hull_width / 2 - track_width / 2")
param_expr(:neg_track_y, :mm, "0 mm - track_y")
param_expr(:track_z, :mm, "track_height / 2")
param_expr(:hull_z, :mm, "track_height + hull_height / 2 - 4 mm")
param_expr(:turret_z, :mm, "track_height + hull_height + turret_height / 2 - 4 mm")
param_expr(:deck_z, :mm, "track_height + hull_height - 4 mm")
param_expr(:dome_z, :mm, "deck_z + turret_height - 2 mm")
param_expr(:barrel_x, :mm, "turret_radius + barrel_length / 2 - 14 mm")
param_expr(:barrel_z, :mm, "deck_z + 8 mm")
param_expr(:antenna_z, :mm, "deck_z + 20 mm")

datum_csys(:tank_csys, 0mm, 0mm, 0mm, 1, 0, 0, 0, 1, 0)

# Tracks.
cube(:track_l0, :hull_length, :track_width, :track_height)
translate(:track_left, :track_l0, 0mm, :track_y, :track_z)
cube(:track_r0, :hull_length, :track_width, :track_height)
translate(:track_right, :track_r0, 0mm, :neg_track_y, :track_z)

# Left wheels (x = -90,-54,-18,18,54,90).
cylinder(:wl0, :wheel_radius, :wheel_width)
rotate(:wl0r, :wl0, 90deg, 0deg, 0deg)
translate(:wl0p, :wl0r, -90mm, :track_y, :wheel_z)
cylinder(:wl1, :wheel_radius, :wheel_width)
rotate(:wl1r, :wl1, 90deg, 0deg, 0deg)
translate(:wl1p, :wl1r, -54mm, :track_y, :wheel_z)
cylinder(:wl2, :wheel_radius, :wheel_width)
rotate(:wl2r, :wl2, 90deg, 0deg, 0deg)
translate(:wl2p, :wl2r, -18mm, :track_y, :wheel_z)
cylinder(:wl3, :wheel_radius, :wheel_width)
rotate(:wl3r, :wl3, 90deg, 0deg, 0deg)
translate(:wl3p, :wl3r, 18mm, :track_y, :wheel_z)
cylinder(:wl4, :wheel_radius, :wheel_width)
rotate(:wl4r, :wl4, 90deg, 0deg, 0deg)
translate(:wl4p, :wl4r, 54mm, :track_y, :wheel_z)
cylinder(:wl5, :wheel_radius, :wheel_width)
rotate(:wl5r, :wl5, 90deg, 0deg, 0deg)
translate(:wl5p, :wl5r, 90mm, :track_y, :wheel_z)

# Right wheels.
cylinder(:wr0, :wheel_radius, :wheel_width)
rotate(:wr0r, :wr0, 90deg, 0deg, 0deg)
translate(:wr0p, :wr0r, -90mm, :neg_track_y, :wheel_z)
cylinder(:wr1, :wheel_radius, :wheel_width)
rotate(:wr1r, :wr1, 90deg, 0deg, 0deg)
translate(:wr1p, :wr1r, -54mm, :neg_track_y, :wheel_z)
cylinder(:wr2, :wheel_radius, :wheel_width)
rotate(:wr2r, :wr2, 90deg, 0deg, 0deg)
translate(:wr2p, :wr2r, -18mm, :neg_track_y, :wheel_z)
cylinder(:wr3, :wheel_radius, :wheel_width)
rotate(:wr3r, :wr3, 90deg, 0deg, 0deg)
translate(:wr3p, :wr3r, 18mm, :neg_track_y, :wheel_z)
cylinder(:wr4, :wheel_radius, :wheel_width)
rotate(:wr4r, :wr4, 90deg, 0deg, 0deg)
translate(:wr4p, :wr4r, 54mm, :neg_track_y, :wheel_z)
cylinder(:wr5, :wheel_radius, :wheel_width)
rotate(:wr5r, :wr5, 90deg, 0deg, 0deg)
translate(:wr5p, :wr5r, 90mm, :neg_track_y, :wheel_z)

# Hull, turret, dome, barrel, antenna.
cube(:hull0, :hull_length, :hull_width, :hull_height)
translate(:hull, :hull0, 0mm, 0mm, :hull_z)
cylinder(:turret0, :turret_radius, :turret_height)
translate(:turret, :turret0, -10mm, 0mm, :turret_z)
sphere(:dome0, :dome_radius)
translate(:dome, :dome0, -10mm, 0mm, :dome_z)
cylinder(:barrel0, :barrel_radius, :barrel_length)
rotate(:barrel1, :barrel0, 0deg, 90deg, 0deg)
translate(:barrel, :barrel1, :barrel_x, 0mm, :barrel_z)
cylinder(:antenna0, 1mm, 40mm)
translate(:antenna, :antenna0, -30mm, -18mm, :antenna_z)

# Assemble with exact boolean unions.
union(:gear_l, :track_left, :wl0p)
union(:gear_l1, :gear_l, :wl1p)
union(:gear_l2, :gear_l1, :wl2p)
union(:gear_l3, :gear_l2, :wl3p)
union(:gear_l4, :gear_l3, :wl4p)
union(:gear_l5, :gear_l4, :wl5p)
union(:gear_r, :track_right, :wr0p)
union(:gear_r1, :gear_r, :wr1p)
union(:gear_r2, :gear_r1, :wr2p)
union(:gear_r3, :gear_r2, :wr3p)
union(:gear_r4, :gear_r3, :wr4p)
union(:gear_r5, :gear_r4, :wr5p)
union(:upper, :hull, :turret)
union(:upper1, :upper, :dome)
union(:upper2, :upper1, :barrel)
union(:upper3, :upper2, :antenna)
union(:tank, :gear_l5, :gear_r5)
union(:tank_final, :tank, :upper3)
colour(:tank_paint, :tank_final, 0.45, 0.55, 0.35, 1.0)
recompute()
