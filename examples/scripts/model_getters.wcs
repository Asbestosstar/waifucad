# Ruby-like WCS model-introspection example. Getter output variables live only
# in the script runtime; read-only getters are not semantic journal mutations.
model(:getter_demo)
param(:width, 40.mm)
param(:depth, 25.mm)
param(:height, 10.mm)
box(:base, :width, :depth, :height)
translate(:raised, :base, 0.mm, 0.mm, 12.mm)
pmi_add(:note, :inspection_note, "Check base envelope", :base)
recompute()

model_name = get_model_name()
parameter_count = get_parameter_count()
parameter_0 = get_parameter_name(0)
width_value = get_parameter_value(:width)
width_unit = get_parameter_unit(:width)
width_users = get_parameter_dependant_count(:width)
width_user_0 = get_parameter_dependant_name(:width, 0)

feature_count = get_feature_count()
feature_0 = get_feature_name(0)
base_kind = get_feature_kind(:base)
base_role = get_feature_role(:base)
base_status = get_feature_geometry_status(:base)
base_bounds_source = get_feature_bounds_source(:base)
base_bounds = get_feature_bounds(:base)
base_volume = get_feature_volume(:base)
base_area = get_feature_surface_area(:base)
base_com = get_feature_centre_of_mass(:base)
base_topology = get_feature_exact_topology_counts(:base)
raised_operands = get_feature_operand_count(:raised)
raised_operand_0_kind = get_feature_operand_kind(:raised, 0)
raised_operand_0_name = get_feature_operand_name(:raised, 0)
base_dependants = get_feature_dependant_count(:base)
base_dependant_0 = get_feature_dependant_name(:base, 0)

pmi_count = get_pmi_count()
pmi_0 = get_pmi_name(0)
pmi_kind = get_pmi_kind(:inspection_note)
pmi_text = get_pmi_text(:inspection_note)
pmi_feature = get_pmi_feature_name(:inspection_note)

# Values can be consumed by later script logic or printed for a human/AI CLI.
echo_value(:model_name)
echo_value(:parameter_count)
echo_value(:base_kind)
echo_value(:base_role)
echo_value(:base_status)
echo_value(:base_bounds)
echo_value(:base_volume)
echo_value(:base_topology)
echo_value(:pmi_text)

# Persistent exact topology IDs are strings, not rebuild-local BRep indices.
base_body_id = get_feature_persistent_body_id(:base)
base_face0_id = get_feature_face_persistent_id(:base, 0)
base_face0_kind = get_topology_kind(base_face0_id)
base_face0_surface = get_topology_face_surface_kind(base_face0_id)
echo_value(:base_body_id)
echo_value(:base_face0_id)
echo_value(:base_face0_surface)

