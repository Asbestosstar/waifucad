# Ruby-like WaifuCAD Scripting Language (.wcs)
waifucad(0.1)
model(:scad_interchange_demo)

# Import through the external evaluator as a dumb mesh.
scad_import(:imported_scad, "examples/openscad/external_import_demo.scad", :auto, 1, 64, 8, 0.5, :auto, 0, 0.00001, 1)

# Export only dumb bodies. The result is polyhedron-only SCAD, not history.
scad_export("build/openscad_roundtrip.scad", :all_dumb, 10, 10, 64, 8, 0.5, 1, :reject, 0)

