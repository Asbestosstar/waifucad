# Feature-dialogue edit transaction regression.
model(:feature_dialogue_edit)
sketch(:profile, :XY)
sketch_rect(:rectangle, :profile, 40.mm, 20.mm, true)
extrude(:body, :profile, 10.mm)
body_id_before = get_feature_id(:body)
feature_edit(:body, :extrude, :profile, 25.mm, 0, 0, 0, 0)
recompute()
body_id_after = get_feature_id(:body)
body_bounds = get_feature_bounds(:body)
body_volume = get_feature_volume(:body)
echo_value(:body_id_before)
echo_value(:body_id_after)
echo_value(:body_bounds)
echo_value(:body_volume)
